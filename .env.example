# SwarmResearch configuration (pydantic-settings, prefix SWARM_)
# Offline mode is the default: deterministic, fully local, no network calls.
SWARM_OFFLINE=true

# LLM endpoint (OpenAI-compatible /chat/completions). Only used when SWARM_OFFLINE=false.
SWARM_LLM_BASE_URL=https://api.openai.com/v1
SWARM_LLM_API_KEY=
SWARM_LLM_MODEL=gpt-4o-mini

# Optional web search endpoint (POST JSON {query, max_docs} -> [{doc_id,title,score,snippet}]).
# Empty = bundled corpus backend only.
SWARM_WEB_SEARCH_ENDPOINT=

# Orchestrator budgets
SWARM_MAX_CONCURRENCY=4
SWARM_MAX_DOCS_PER_TASK=4
SWARM_CLAIMS_PER_DOC=5
SWARM_TOKEN_BUDGET=6000
SWARM_COVERAGE_THRESHOLD=0.8
